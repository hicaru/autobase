# Copy to /etc/autobase-bot.env (chmod 600, owned by root). NEVER commit a real key.
# Keeper hot wallet. Must equal vault.keeper(). Removed from the process env right after startup.
KEEPER_PRIVATE_KEY=
VAULT_ADDRESS=
# Block the vault was deployed at (indexer start).
VAULT_DEPLOY_BLOCK=

PRIMARY_RPC=https://eth.bearby.ru
FALLBACK_RPCS=https://eth.drpc.org,https://ethereum-rpc.publicnode.com,https://1rpc.io/eth,https://rpc.flashbots.net
# Rebalance txs go here first (no public mempool). Empty = public broadcast only.
PRIVATE_TX_RPCS=https://rpc.flashbots.net/fast,https://rpc.mevblocker.io

# Bearer token for the API, >= 32 chars:  openssl rand -hex 32
API_KEY=
API_BIND=127.0.0.1:8080
DB_PATH=/var/lib/autobase-bot/autobase.sqlite

# Strategy
TARGET_DAYS_IN_RANGE=20
VOL_LOOKBACK_HOURS=168
# token1 base units (XAUT: 1000000 = 1 XAUT)
COMPOUND_MIN_VALUE=500000

# Gas
MAX_BASE_FEE_GWEI=30
MAX_FEE_GWEI=100
PRIORITY_FEE_GWEI=1
MAX_OUT_OF_RANGE_MINUTES=120
MIN_KEEPER_BALANCE_ETH=0.05

LOG_JSON=true
